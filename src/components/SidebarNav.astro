---
import type { NavigationGroup } from "../utils/navigation";

interface Props {
  navigation: NavigationGroup[];
  currentPath: string;
}

const { navigation, currentPath } = Astro.props;
---

<nav aria-label='Primary' class='docs-sidebar-nav'>
  {
    navigation.map((group) => (
      <section class='space-y-2'>
        <h2 class='px-3 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400'>
          {group.title}
        </h2>
        <ul class='space-y-0.5'>
          {group.items.map((item) => {
            const isActive = item.slug === currentPath;
            return (
              <li>
                <a
                  href={item.slug}
                  data-active={isActive ? "true" : "false"}
                  class={`block rounded-md px-3 py-1.5 text-sm transition-colors ${
                    isActive
                      ? "bg-blue-50 font-medium text-blue-700 dark:bg-blue-950/50 dark:text-blue-400"
                      : "text-slate-700 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800/50 dark:hover:text-slate-100"
                  }`}
                >
                  {item.title}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</nav>
