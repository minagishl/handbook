---
import { getCollection } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { buildNavigation, findNeighbors } from "../../utils/navigation";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({
    params: { slug: entry.slug },
    props: { id: entry.id },
  }));
}

const docs = await getCollection("docs");
const navigation = buildNavigation(docs);
const { id } = Astro.props;
const entry = docs.find((doc) => doc.id === id);

if (!entry) {
  throw new Error(`Doc entry ${id} not found.`);
}

const { Content, headings } = await entry.render();
const { previous, next } = findNeighbors(navigation, `/docs/${entry.slug}`);
---

<DocsLayout
  entry={entry}
  navigation={navigation}
  headings={headings}
  previous={previous}
  next={next}
>
  <Content />
</DocsLayout>
